# ── Nebius Token Factory (required) ──
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# ── NVIDIA Nemotron model routing (verify IDs with: python scripts/check_models.py) ──
# Fast: intent routing, follow-up rewriting, streamed spoken answer
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_FAST_FALLBACK=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Streamed spoken answer (defaults to MODEL_FAST)
# MODEL_ANSWER=nvidia/Nemotron-3_5-Lightning
# Routing that needs reasoning (references, remembered facts, clarifying questions)
# MODEL_ROUTER_REASONING=nvidia/nemotron-3-super-120b-a12b
# Text-to-SQL (with error-feedback repair)
MODEL_SQL=nvidia/nemotron-3-super-120b-a12b
# Complex questions (comparisons, rankings, recommendations) + escalation after 2 SQL failures
MODEL_COMPLEX=nvidia/Nemotron-3-Ultra-550b-a55b
# Ask the chat template to skip <think> traces (they are stripped either way)
LLM_DISABLE_THINKING=1
LLM_TIMEOUT=60

# ── Tavily web search (optional; enables "web" and "hybrid" questions) ──
TAVILY_API_KEY=

# ── Nemotron ASR endpoint (optional; falls back to the browser Web Speech API) ──
# e.g. https://<your-endpoint>.endpoints.nebius.cloud
ASR_URL=
ASR_TOKEN=
ASR_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b

# ── Spoken replies ──
# browser = the browser's own voices (default) · edge = neural voices incl. Saudi Arabic
# (ar-SA Hamed / Zariyah) · openai = any OpenAI-compatible /v1/audio/speech (TTS_URL)
TTS_PROVIDER=browser
TTS_URL=
TTS_TOKEN=
TTS_RATE=+0%

# ── Data + safety ──
DB_PATH=data/mats_demo.db
MEMORY_DB_PATH=data/memory.db
MAX_ROWS=200
QUERY_TIMEOUT=3
